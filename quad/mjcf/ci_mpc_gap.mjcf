<mujoco model="ci_mpc_gap">
  <!-- Minimal gap course for sampling CI-MPC crossing demo. Platform tops flush with
       the robot's standing ground (z=0). At runtime the robot's infinite floor is
       disabled (DISABLE_FLOOR=1) so gaps between platforms are real voids. Gaps are
       narrow (0.05 m) and close to the start so the slow gait can reach and clear them
       (a foot placed in a gap falls through). -->
  <include file="quad_real_17dof_waist_sphere.mjcf"/>
  <worldbody>
    <!-- start platform: x in [-0.55, 0.50] -->
    <geom name="plat0" type="box" group="2" size="0.525 0.7 0.1" pos="-0.025 0 -0.1"
          rgba="0.50 0.55 0.62 1" friction="1.3 0.02 0.001" condim="3"/>
    <!-- gap 0.05 @ x=0.50..0.55 -->
    <geom name="plat1" type="box" group="2" size="0.46 0.7 0.1" pos="1.01 0 -0.1"
          rgba="0.44 0.50 0.60 1" friction="1.3 0.02 0.001" condim="3"/>
    <!-- gap 0.05 @ x=1.47..1.52 -->
    <geom name="plat2" type="box" group="2" size="0.55 0.7 0.1" pos="2.07 0 -0.1"
          rgba="0.50 0.55 0.62 1" friction="1.3 0.02 0.001" condim="3"/>
  </worldbody>
</mujoco>
