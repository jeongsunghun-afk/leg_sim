<mujoco model="terrain_course4">
  <!-- ★4라인 종합코스(2026-07-15 재구성): gap·stepping을 별도 라인에 분리(같은 라인 연속=간격 다른 정렬속도 요구라 불가).
       라인 배치(y): +1.2=갭 / −1.2=스테핑(안쪽=도달 쉬움) · +3.6=마찰 / −3.6=완만험지(바깥).
       각 라인은 단일 장애물 = ③ selectFoot로 각자 정렬속도(walk 0.5)에 건널 수 있음. 조향해 라인 진입. -->
  <include file="quad_real_17dof_waist_sphere.mjcf"/>
  <worldbody>
    <!-- ── 라인 A (y=+1.2): 갭 GAP (0.32m 갭·0.70폭 발판·높이0.16) ── -->
    <geom name="gp0" type="box" group="2" size="0.350 0.700 0.080" pos="1.550 1.200 0.080" rgba="0.48 0.54 0.64 1"/>
    <geom name="gp1" type="box" group="2" size="0.350 0.700 0.080" pos="2.570 1.200 0.080" rgba="0.42 0.48 0.58 1"/>
    <geom name="gp2" type="box" group="2" size="0.350 0.700 0.080" pos="3.590 1.200 0.080" rgba="0.48 0.54 0.64 1"/>

    <!-- ── 라인 B (y=−1.2): 스테핑 STEPPING STONE (0.44m 간격·0.13발판·높이0.13, ±0.22 좌우) ── -->
    <geom name="t0L" type="box" group="2" size="0.130 0.130 0.065" pos="1.200 -0.980 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t0R" type="box" group="2" size="0.130 0.130 0.065" pos="1.200 -1.420 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t1L" type="box" group="2" size="0.130 0.130 0.065" pos="1.640 -0.980 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t1R" type="box" group="2" size="0.130 0.130 0.065" pos="1.640 -1.420 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t2L" type="box" group="2" size="0.130 0.130 0.065" pos="2.080 -0.980 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t2R" type="box" group="2" size="0.130 0.130 0.065" pos="2.080 -1.420 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t3L" type="box" group="2" size="0.130 0.130 0.065" pos="2.520 -0.980 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t3R" type="box" group="2" size="0.130 0.130 0.065" pos="2.520 -1.420 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t4L" type="box" group="2" size="0.130 0.130 0.065" pos="2.960 -0.980 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t4R" type="box" group="2" size="0.130 0.130 0.065" pos="2.960 -1.420 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t5L" type="box" group="2" size="0.130 0.130 0.065" pos="3.400 -0.980 0.065" rgba="0.38 0.55 0.44 1"/>
    <geom name="t5R" type="box" group="2" size="0.130 0.130 0.065" pos="3.400 -1.420 0.065" rgba="0.38 0.55 0.44 1"/>

    <!-- ── 라인 C (y=+3.6): 마찰 FRICTION (낮은 저마찰 판) ── -->
    <geom name="f0" type="box" group="2" size="0.600 0.700 0.012" pos="1.800 3.600 0.012" rgba="0.60 0.62 0.66 1" friction="0.50 0.02 0.001" priority="1"/>
    <geom name="f1" type="box" group="2" size="0.600 0.700 0.012" pos="3.000 3.600 0.012" rgba="0.62 0.72 0.85 1" friction="0.30 0.01 0.0005" priority="1"/>
    <geom name="f2" type="box" group="2" size="0.600 0.700 0.012" pos="4.200 3.600 0.012" rgba="0.66 0.78 0.90 1" friction="0.20 0.01 0.0005" priority="1"/>

    <!-- ── 라인 D (y=−3.6): 완만 험지 ROUGH (낮은 요철 ~2–3cm) ── -->
    <geom name="r0" type="box" group="2" size="0.250 0.600 0.025" pos="1.500 -3.600 0.025" rgba="0.55 0.50 0.42 1"/>
    <geom name="r1" type="box" group="2" size="0.250 0.600 0.030" pos="2.100 -3.520 0.030" rgba="0.58 0.52 0.44 1"/>
    <geom name="r2" type="box" group="2" size="0.250 0.600 0.020" pos="2.700 -3.680 0.020" rgba="0.55 0.50 0.42 1"/>
    <geom name="r3" type="box" group="2" size="0.250 0.600 0.030" pos="3.300 -3.560 0.030" rgba="0.58 0.52 0.44 1"/>
    <geom name="r4" type="box" group="2" size="0.250 0.600 0.025" pos="3.900 -3.620 0.025" rgba="0.55 0.50 0.42 1"/>
  </worldbody>
</mujoco>
