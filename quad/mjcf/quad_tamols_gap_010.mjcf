<mujoco model="tamols_gap">
  <!-- TAMOLS 0.20m 갭 실행검증: 평지레벨 플랫폼(top z=0) 2장 + 갭 x∈[0.45,0.65].
       DISABLE_FLOOR=1로 로봇 무한바닥 접촉off → 갭=진짜 구멍(발 빠짐).
       로봇 x=0 스폰(plat_pre 위, 초기 앞발 x≈0.30 < 0.45 = solid). TAMOLS 현재위치 앵커라 갭 정합. -->
  <include file="quad_real_17dof_waist_sphere.mjcf"/>
  <worldbody>
    <geom name="plat_pre"  type="box" group="2" size="0.525 0.7 0.10" pos="-0.075 0 -0.10" rgba="0.48 0.54 0.64 1"/>
    <!-- gap 0.20 @ x=0.45..0.65 (void) -->
    <geom name="plat_post" type="box" group="2" size="0.635 0.7 0.10" pos="1.185 0 -0.10" rgba="0.42 0.48 0.58 1"/>
  </worldbody>
</mujoco>
