<mujoco model="biped_cad_2.urdf">
  <!--
    ★03_Leg_UFDF_Colision_260617_2.urdf 에서 tools/urdf_to_mjcf.py 로 생성. 손으로 고치지 말 것 —
      CAD 가 갱신되면 스크립트를 다시 돌린다.

    URDF 에서 온 것 : 링크 트리 · 관절 원점/축/범위 · 질량 · 전관성 · 메시 · effort
    사람이 정한 것   : 바닥 · 조명 · IMU site · actuator · sensor · option · default ·
                      **접촉구(sphere, r=0.036)** — URDF 에는 이런 개념이 없다

    ⚠발 구성: 평발 — 링크메시는 시각 전용, 접촉은 발목(heel)+발끝(toe) **2점 구**
    ⚠관절범위: 새 URDF 값 그대로
    ⚠armature/damping/frictionloss 는 **의도적으로 없다** — 런타임(setup_gearbox)이 주입한다.
      여기 적으면 이중적용된다. **tendon 의 armature 도 같다** — 구조(joint·coef)만 여기 있고
      값은 런타임이 넣는다. foot 의 `dof_armature` 는 tendon 으로 **옮겨 갔다**(0 이어야 정상).
    ⚠**MuJoCo 로드 검증 미실시** — 생성 환경(Pi)에 mujoco 가 없다. 노트북에서 반드시 확인할 것.
  -->
  <compiler angle="radian" meshdir="03_Leg_UFDF_Colision_260811_1/meshes_mjcf/" />
  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.33 0.36 0.40" rgb2="0.42 0.45 0.50" width="512" height="512" />
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="12 12" reflectance="0.12" />
    <mesh name="base_collision" content_type="model/stl" file="base_collision.STL" />
    <mesh name="HL_hip_link_collision" content_type="model/stl" file="HL_hip_link_collision.STL" />
    <mesh name="HL_thigh_link_collision" content_type="model/stl" file="HL_thigh_link_collision.STL" />
    <mesh name="HL_calf_link_collision" content_type="model/stl" file="HL_calf_link_collision.STL" />
    <mesh name="HL_foot_link_collision" content_type="model/stl" file="HL_foot_link_collision.STL" />
    <mesh name="HL_foot_contact_link_collision" content_type="model/stl" file="HL_foot_contact_link_collision.STL" />
    <mesh name="HR_hip_link_collision" content_type="model/stl" file="HR_hip_link_collision.STL" />
    <mesh name="HR_thigh_link_collision" content_type="model/stl" file="HR_thigh_link_collision.STL" />
    <mesh name="HR_calf_link_collision" content_type="model/stl" file="HR_calf_link_collision.STL" />
    <mesh name="HR_foot_link_collision" content_type="model/stl" file="HR_foot_link_collision.STL" />
    <mesh name="HR_foot_contact_link_collision" content_type="model/stl" file="HR_foot_contact_link_collision.STL" />
  </asset>
  <worldbody>
    <body name="torso" pos="0 0 0.5257">
      <freejoint name="root" />
      <inertial pos="-0.072651 -4.4686e-05 2.7227e-06" mass="2.8" fullinertia="0.0029362 0.0016967 0.0017243 4.3897e-06 3.2284e-07 -3.3685e-10" />
      <site name="imu" pos="0 0 0.05" size="0.01" />   <!-- ★IMU 장착점(실기 반영) -->
      <!-- ★★실물 페이로드 (2026-09-04 실기 체중계 15.9kg vs 모델 13.9 = +2.0kg = 배터리·배선·하네스).
           결손 1.5~2배의 무게 몫(+14%)을 여기서 없앤다. mj_getTotalmass·qfrc_bias 가 자동 반영되어
           hold FF(mg/2)·G(q)·QP 분배가 전부 실물 무게로 맞춰진다. (body 당 inertial 은 하나뿐이라
           torso inertial 을 안 건드리고 자식 body 로 더한다 — 고정 결합이라 동역학상 동일.)
           ⚠pos.x 는 **잠정값**: 실기가 "저울 위에서 앞으로 쏠린다"·"뒤꿈치 먼저 접지"라
             CoM 이 앞이지만, 전방량 Δx 는 토크만으로는 전달비 r 과 분리 불가(둘 다 발목토크↑).
             플럼라인 **측면 사진**의 수직선 위치로 Δx 를 확정한 뒤 이 x 를 조정할 것.
             지금은 배터리 통상 위치(torso 중앙 약간 앞·위)로 두어 관측된 전방 쏠림과 부호만 맞춘다. -->
      <body name="payload" pos="0.02 0 0.04">
        <inertial pos="0 0 0" mass="2.0" diaginertia="0.004 0.004 0.004" />
      </body>
      <!-- ★torso 충돌 ON (2026-08-13). 종전 contype=0 이라 몸통이 지면을 통과했고 넘어짐을
           학습·평가할 수 없었다. 점발판과 **같은 비트마스크**를 쓴다(이 모델은 다리 메시가
           충돌 OFF 라 기본값도 안전하지만, 두 MJCF 가 갈리면 그게 다음 사고다).
           torso(2,2)·floor(3,3) ⇒ torso↔floor ✓ · 다리↔floor ✓ · torso↔다리 ✗.
           density=0 유지 — 질량이 늘면 총질량 13.5707 kg 이 바뀌어 전부 어긋난다. -->
      <geom type="mesh" contype="2" conaffinity="2" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="base_collision" />
        <body name="HL_hip_link" pos="-0.225 0.0225 0">
          <inertial pos="0.026196 0.039035 -5.8825e-05" mass="1.3" fullinertia="0.0005559 0.00078767 0.00044966 1.3767e-05 2.7997e-09 -1.4339e-09" />
          <joint name="HL_hip_joint" pos="0 0 0" axis="1 0 0" range="-0.26 0.26" actuatorfrcrange="-84 84" />
          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HL_hip_link_collision" />
          <body name="HL_thigh_link" pos="0 0.115 0">
            <inertial pos="0.055714 0.00033952 -0.077945" mass="3.3" fullinertia="0.005622 0.0094645 0.0040228 1.4966e-06 0.002616 -4.1319e-06" />
            <joint name="HL_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.13 2.36" actuatorfrcrange="-84 84" />
            <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HL_thigh_link_collision" />
            <body name="HL_calf_link" pos="0.13192 0 -0.1884">
              <inertial pos="-0.075484 0.000115677 -0.0672663" mass="0.65207" fullinertia="0.00111501 0.00267927 0.00159557 -6.32969e-10 -0.00116384 -1.22739e-10" />
              <joint name="HL_calf_joint" pos="0 0 0" axis="0 1 0" range="-1.1868 0.87" actuatorfrcrange="-226.8 226.8" />   <!-- ★226.8=126+100.8: calf 관절은 두 드라이브의 힘을 받는다. 근거는 점발판 주석 -->
              <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HL_calf_link_collision" />
              <body name="HL_foot_link" pos="-0.18768 0 -0.15748">
                <inertial pos="0.0107476 -1.39397e-12 -0.0609525" mass="0.204919" fullinertia="0.000271645 0.000305655 3.80453e-05 -1.07641e-10 4.25117e-05 -1.89644e-11" />
                <joint name="HL_foot_joint" pos="0 0 0" axis="0 1 0" range="-1.48 1.1694" actuatorfrcrange="-100.8 100.8" />
                <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HL_foot_link_collision" />
                <geom name="HL_sphere2" type="sphere" size="0.036" pos="0 0 0" rgba="0.3 0.5 0.9 1" friction="1.6 0.05 0.001" condim="3" solref="0.004 1" solimp="0.95 0.99 0.001" />
                <body name="HL_foot_contact_link" pos="0.025353 0 -0.14378">
                  <inertial pos="0.00167427 -8.03431e-09 -0.00949524" mass="0.0420009" fullinertia="1.23353e-05 1.66282e-05 1.63264e-05 -6.12961e-12 -7.26317e-07 -7.88503e-13" />
                  <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HL_foot_contact_link_collision" />
                  <geom name="HL_sphere" type="sphere" size="0.036" pos="0 0 0" rgba="0.9 0.3 0.3 1" friction="1.6 0.05 0.001" condim="3" solref="0.004 1" solimp="0.95 0.99 0.001" />
                </body>
              </body>
            </body>
          </body>
        </body>
        <body name="HR_hip_link" pos="-0.225 -0.0225 0">
          <inertial pos="0.044964 -0.03664 4.8852e-05" mass="1.4" fullinertia="0.00055198 0.00081827 0.00046473 -2.2357e-06 -2.7997e-09 -1.4339e-09" />
          <joint name="HR_hip_joint" pos="0 0 0" axis="1 0 0" range="-0.26 0.26" actuatorfrcrange="-84 84" />
          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HR_hip_link_collision" />
          <body name="HR_thigh_link" pos="0 -0.115 0">
            <inertial pos="0.054189 -0.00033953 -0.079013" mass="3.3" fullinertia="0.0058914 0.0094645 0.0037534 -3.3709e-06 0.002518 2.8196e-06" />
            <joint name="HR_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.13 2.36" actuatorfrcrange="-84 84" />
            <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HR_thigh_link_collision" />
            <body name="HR_calf_link" pos="0.13192 0 -0.1884">
              <inertial pos="-0.075484 -0.000113252 -0.0672663" mass="0.65207" fullinertia="0.00111501 0.00267927 0.00159557 5.2813e-10 -0.00116384 8.19537e-11" />
              <joint name="HR_calf_joint" pos="0 0 0" axis="0 1 0" range="-1.1868 0.87" actuatorfrcrange="-226.8 226.8" />   <!-- ★226.8=126+100.8: calf 관절은 두 드라이브의 힘을 받는다. 근거는 점발판 주석 -->
              <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HR_calf_link_collision" />
              <body name="HR_foot_link" pos="-0.18768 0 -0.15748">
                <inertial pos="0.0107476 -1.394e-12 -0.0609525" mass="0.204919" fullinertia="0.000271645 0.000305655 3.80453e-05 -1.07641e-10 4.25117e-05 -1.89644e-11" />
                <joint name="HR_foot_joint" pos="0 0 0" axis="0 1 0" range="-1.48 1.1694" actuatorfrcrange="-100.8 100.8" />
                <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HR_foot_link_collision" />
                <geom name="HR_sphere2" type="sphere" size="0.036" pos="0 0 0" rgba="0.3 0.5 0.9 1" friction="1.6 0.05 0.001" condim="3" solref="0.004 1" solimp="0.95 0.99 0.001" />
                <body name="HR_foot_contact_link" pos="0.025353 0 -0.14378">
                  <inertial pos="0.00167427 -8.03431e-09 -0.00949524" mass="0.0420009" fullinertia="1.23353e-05 1.66282e-05 1.63264e-05 -6.12961e-12 -7.26317e-07 -7.88503e-13" />
                  <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.75294 0.75294 0.75294 1" mesh="HR_foot_contact_link_collision" />
                  <geom name="HR_sphere" type="sphere" size="0.036" pos="0 0 0" rgba="0.9 0.3 0.3 1" friction="1.6 0.05 0.001" condim="3" solref="0.004 1" solimp="0.95 0.99 0.001" />
                </body>
              </body>
            </body>
          </body>
        </body>
    </body>
    <geom name="floor" type="plane" size="0 0 0.1" material="floor_mat" contype="3" conaffinity="3" friction="1.6 0.05 0.001" solref="0.004 1" solimp="0.95 0.99 0.001" />
    <light pos="0 0 3" dir="0 0 -1" />
  </worldbody>
  <option timestep="0.002" gravity="0 0 -9.81" />
  <default>
    <!-- ★condim 3 유지. 2026-08-13 에 6 을 시도했다가 되돌렸다 — 근거·실측표는 점발판
         (biped_from_quad.mjcf) 같은 자리 주석. **깨진 게 바로 이 모델의 stand 였다.**
         ⚠이 모델은 발당 접촉구가 2개(sphere+sphere2)라 condim 3 에서도 두 점의 **차동 마찰**로
           요 저항이 생긴다. 즉 "발이 자유롭게 헛돈다" 는 1점 점발 모델의 문제이지 여기 것이
           아니다 — 실기 밑창에 가까운 쪽은 이 2점 모델이고, 그쪽은 이미 yaw 를 버틴다. -->
    <geom friction="1.3 0.02 0.001" condim="3" />
    <motor ctrllimited="true" ctrlrange="-200 200" />
  </default>
  <!-- ★calf→foot 기구 커플링(실기 coef=+1). foot 로터가 raw 각(=foot+coef·calf)으로 돌아
       반사관성이 (calf,foot) 비대각으로 걸린다 — dof_armature 로는 표현 불가.
       armature 값은 여기 적지 않는다(런타임 setup_gearbox 주입. 여기 적으면 이중적용). -->
  <tendon>
    <fixed name="HL_foot_rotor">
      <joint joint="HL_calf_joint" coef="1" />
      <joint joint="HL_foot_joint" coef="1" />
    </fixed>
    <fixed name="HR_foot_rotor">
      <joint joint="HR_calf_joint" coef="1" />
      <joint joint="HR_foot_joint" coef="1" />
    </fixed>
  </tendon>
  <actuator>
    <!-- ★2026-08-13 발목 액추에이터를 **tendon 으로 옮겼다**(실기 기구 커플링 반영).
         점발판(biped_from_quad.mjcf)의 같은 블록과 **반드시 같이** 고칠 것. 근거는 그쪽 주석. -->
    <motor joint="HL_hip_joint" name="HL_hip" ctrlrange="-84 84" />
    <motor joint="HL_thigh_joint" name="HL_thigh" ctrlrange="-84 84" />
    <motor joint="HL_calf_joint" name="HL_calf" ctrlrange="-126 126" />
    <motor tendon="HL_foot_rotor" name="HL_foot" ctrlrange="-100.8 100.8" />
    <motor joint="HR_hip_joint" name="HR_hip" ctrlrange="-84 84" />
    <motor joint="HR_thigh_joint" name="HR_thigh" ctrlrange="-84 84" />
    <motor joint="HR_calf_joint" name="HR_calf" ctrlrange="-126 126" />
    <motor tendon="HR_foot_rotor" name="HR_foot" ctrlrange="-100.8 100.8" />
  </actuator>
  <!-- ★IMU 센서(실기 반영): 상태추정기 입력. framepos/framelinvel 은 GT 비교 전용. -->
  <sensor>
    <gyro          site="imu" name="imu_gyro"  />
    <accelerometer site="imu" name="imu_acc"   />
    <framequat     objtype="site" objname="imu" name="imu_quat" />
    <framepos      objtype="site" objname="imu" name="gt_pos"  />
    <framelinvel   objtype="site" objname="imu" name="gt_vel"  />
  </sensor>
</mujoco>
